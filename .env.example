# Required
OPENAI_API_KEY=sk-...

# Optional
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort for reasoning models (none/minimal/low/medium/high). Leave empty for non-reasoning models.
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Max user messages per chat session (protects the API key in public demos)
MAX_MESSAGES_PER_SESSION=40
